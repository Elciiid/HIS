.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Run outputs are regenerated, so they stay out of the repo -- except the
# verification records, which are the evidence behind every claim in the README
# and are small enough to version.
artifacts/*
!artifacts/benchmark_report.md
!artifacts/benchmark_results.json
!artifacts/config_benchmark.json
!artifacts/precision_study.md
!artifacts/precision_study.json
!artifacts/batch_throughput.md
!artifacts/batch_throughput.json
!artifacts/batch_measured.json
!artifacts/batch_study.log
!artifacts/grouping_study.md
!artifacts/grouping_study.json
!artifacts/overnight_log.md
!artifacts/predict_speed.md
!artifacts/predict_speed.json
!artifacts/cost_projection.md
!artifacts/cost_projection.json
!artifacts/training_speed.json
!artifacts/step_demand.md
!artifacts/step_demand.json
!artifacts/phase1.json
